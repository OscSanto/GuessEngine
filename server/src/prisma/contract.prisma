// use prisma-next
// Models required{Topic, Item, StatType, StatValue, VoteDimension,Player, Guess,Vote}

model Topic {
  id          String   @id @default(uuid())  // primary key, auto-generated
  slug        String   @unique               // "fastfood" — URL-friendly, no dupes
  name        String                         // "Fast Food Showdown"
  description String?                         // optional (the ? makes it nullable)
  isActive    Boolean  @default(true)         // toggle a topic on/off

  // Relations — a topic HAS MANY of each of these.
  // These are lists; the actual FK lives on the child models.
  statTypes      StatType[]
  voteDimensions VoteDimension[]
  items          Item[]
}
model Item {
  id       String  @id @default(uuid())
  topicId  String
  name     String                         // "Big Mac", "Abyssal whip"
  imageUrl String?                        // shown in the higher/lower cards

  topic      Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  statValues StatValue[]                   // an item HAS MANY stat values
}

model StatValue {
  id         String  @id @default(uuid())
  itemId     String
  statTypeId String
  value      Decimal                       // 563 (calories), 2.99 (price)

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  statType StatType @relation(fields: [statTypeId], references: [id], onDelete: Cascade)

  @@unique([itemId, statTypeId])            // one value per item per stat
}

model StatType {
  id          String  @id @default(uuid())
  topicId     String
  key         String                        // "calories" — used by code
  label       String                        // "Calories" — shown to users
  isGuessable Boolean @default(true)

  statValues StatValue[]
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([topicId, key])
}

model VoteDimension {
  id      String @id @default(uuid())
  topicId String
  key     String                            // "taste"
  label   String                            // "Which tastes better?"

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  votes Vote[]
  @@unique([topicId, key])
}

model Player {
  id        String   @id @default(uuid())
  token     String   @unique               // IP-derived or cached client token
  createdAt DateTime @default(now())        // when we first saw them

  runs  Run[]                              // a player HAS MANY runs (higher/lower games)
  votes Vote[]                             // and HAS MANY votes
}

// A single higher/lower "run": current (revealed) item, a waiting challenger
// (hidden value), and the streak built up so far. One row per active or
// finished run — a new run replaces a player's previous active one.
//
// topicId / statTypeId / currentItemId / challengerItemId are plain ids, not
// relations — same convention the old Guess/Vote models used: referential
// integrity for these is enforced in application code (see src/routes/runs.ts),
// not by a DB foreign key.
model Run {
  id               String   @id @default(uuid())
  playerId         String
  topicId          String
  statTypeId       String                  // fixed for the whole run
  currentItemId    String                  // revealed to the player
  challengerItemId String                  // hidden until guessed
  streak           Int      @default(0)
  status           String   @default("active") // "active" | "ended"
  createdAt        DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
}

model Vote {
  id          String   @id @default(uuid())
  playerId    String
  dimensionId String                        // which vote axis (e.g. taste)
  itemAId     String                        // normalized: always smaller id first
  itemBId     String
  choice      String                        // "a" or "b" — which they preferred
  createdAt   DateTime @default(now())

  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  dimension VoteDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@index([dimensionId, itemAId, itemBId])
}