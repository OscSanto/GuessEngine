{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src", // when 'rootDir':'./src', any .ts file outside is not compiled. [Ex: prisma migration plan; any .ts at project root; primsa.config.ts; will all cause error]. 
    "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "preserve",
    "target": "esnext",
    "types": [
      "node"
    ],
    // me: changed types[] to types["node"] 
    // For nodejs:
    "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
  },
  "include": ["src/**/*"], //include defines and includes files that follow import statments as 'entry points' and anything they pull in get compiled
  "exclude": ["migrations", "dist"]

}
